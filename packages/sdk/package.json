{
  "name": "@dreamgraph/sdk",
  "version": "11.0.1",
  "description": "DreamGraph plugin authoring SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./events/kinds": {
      "types": "./dist/events/kinds.d.ts",
      "import": "./dist/events/kinds.js"
    },
    "./events/experimental": {
      "types": "./dist/events/experimental.d.ts",
      "import": "./dist/events/experimental.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./reject-reasons": {
      "types": "./dist/reject-reasons.d.ts",
      "import": "./dist/reject-reasons.js"
    },
    "./seams/tools": {
      "types": "./dist/seams/tools.d.ts",
      "import": "./dist/seams/tools.js"
    },
    "./seams/resources": {
      "types": "./dist/seams/resources.d.ts",
      "import": "./dist/seams/resources.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
